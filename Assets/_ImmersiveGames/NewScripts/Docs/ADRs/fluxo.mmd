sequenceDiagram
    autonumber

    participant RMC as RuntimeModeConfig
    participant PS as RuntimePersistentScenesPolicyAsset
    participant Route as SessionOperationalRouteAsset
    participant SOP as SessionOperationalPipeline
    participant Loading as LoadingAdapter
    participant Fade as FadeAdapter
    participant RouteAdapter as RouteTransitionAdapter
    participant SceneExec as SceneCompositionExecutor
    participant SAP as SessionActivityPipeline

    RMC->>PS: guarantee persistent scenes
    RMC->>Route: resolve startup route definition
    Route->>SOP: route topology + route profile

    SOP->>Loading: LoadingPlanReady
    SOP->>SOP: OperationalRouteCommand
    SOP->>Loading: LoadingStarted / showCompleted

    SOP->>Fade: fadeInStarted
    Fade-->>SOP: fadeInCompleted

    SOP->>RouteAdapter: apply route physical transition
    RouteAdapter->>SceneExec: load / unload / set-active
    SceneExec-->>RouteAdapter: SceneCompositionCompleted
    RouteAdapter-->>SOP: RoutePhysicalApply completed

    SOP->>SOP: SessionOperationalSetup
    SOP->>SOP: SelectInitialActivity
    SOP->>SOP: SessionActivityEntryHandoffPrepared

    SOP->>Loading: progress=1 / visual settled / hide
    Loading-->>SOP: LoadingHidden

    SOP->>Fade: fadeOutStarted
    Fade-->>SOP: fadeOutCompleted

    SOP->>SOP: OperationalRouteCompleted
    SOP->>SAP: SessionActivityEntryHandoff
    SAP->>SAP: Activity Activation
